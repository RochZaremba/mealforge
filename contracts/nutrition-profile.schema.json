{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mealforge.local/contracts/nutrition-profile.schema.json",
  "title": "NutritionProfile",
  "type": "object",
  "required": [
    "member_id",
    "kcal_target",
    "protein_target_g",
    "carbs_target_g",
    "fat_target_g",
    "goal_type"
  ],
  "properties": {
    "member_id": {
      "type": "string"
    },
    "kcal_target": {
      "$ref": "#/$defs/nullableEnergy"
    },
    "protein_target_g": {
      "$ref": "#/$defs/nullableMacro"
    },
    "carbs_target_g": {
      "$ref": "#/$defs/nullableMacro"
    },
    "fat_target_g": {
      "$ref": "#/$defs/nullableMacro"
    },
    "goal_type": {
      "enum": [
        "cut",
        "recomposition",
        "maintenance",
        "bulk",
        "custom"
      ]
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "calorie_tolerance_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "macro_tolerance_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.5
    },
    "source": {
      "enum": [
        "user_set",
        "calculator_suggestion_confirmed"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "description": "W01 exact targets: null is unknown, integer JSON or canonical decimal string with at most 6 integer and 3 fraction digits. Floats forbidden; fractional values use strings. This is storage precision, not a dietary recommendation.",
  "$defs": {
    "nullableMacro": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,3})?$"
        }
      ]
    },
    "nullableEnergy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        {
          "type": "string",
          "pattern": "^(?!0(?:\\.0{1,3})?$)(?:0|[1-9][0-9]{0,5})(?:\\.[0-9]{1,3})?$"
        }
      ]
    }
  }
}
